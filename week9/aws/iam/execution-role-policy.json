{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLoginTokenCannotBeScopedToARepository",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullOnlyTheRiskAgentImageFromOurVpc",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage"
      ],
      "Resource": "arn:aws:ecr:us-east-1:ACCOUNT_ID:repository/risk-scoring-agent",
      "Condition": {
        "StringEquals": {
          "aws:SourceVpc": "VPC_ID"
        }
      }
    },
    {
      "Sid": "WriteOnlyTheRiskAgentLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:ACCOUNT_ID:log-group:/ecs/risk-scoring-agent:*"
    }
  ]
}
